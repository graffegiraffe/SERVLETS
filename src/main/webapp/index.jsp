<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome Page</title>
    <style>
        body {
            background-color: #ffe4e1;
            font-family: Arial, sans-serif;
            color: #7f6881;
            text-align: center;
            margin: 0;
            padding: 0;
        }
        h1 {
            color: #ff1493;
            font-size: 2.5em;
            margin-top: 20px;
        }
        p {
            font-size: 1.2em;
        }
        .button {
            background-color: #ff69b4;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 20px;
            font-size: 1em;
            cursor: pointer;
            margin-top: 20px;
            text-decoration: none;
        }
        .button:hover {
            background-color: #ff1493;
        }
    </style>
</head>
<body>
<h1>HI</h1>
<p>Please log in to continue</p>
<a href="/login" class="button">Login</a>
</body>
</html>